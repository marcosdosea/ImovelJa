@model string

@* Selo da situação do pagamento, com ícone e texto (Tela_012) *@

@{
    var situacao = Model switch
    {
        "PA" => (Texto: "Pago", Classe: "selo--aprovado"),
        "EA" => (Texto: "Em atraso", Classe: "selo--reprovado"),
        _ => (Texto: "Pendente", Classe: "selo--pendente")
    };
}

<span class="selo @situacao.Classe">
    @if (Model == "PA")
    {
        <svg class="selo__icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
    }
    else if (Model == "EA")
    {
        <svg class="selo__icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
    }
    else
    {
        <svg class="selo__icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 15 14" /></svg>
    }
    @situacao.Texto
</span>
