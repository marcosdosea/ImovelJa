@using ImovelJaWeb.Models
@model PessoaViewModel

@{
    ViewData["Title"] = "Detalhes do Usuário";

    var ptBR = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var imoveis = ViewBag.imoveis as IEnumerable<ImovelViewModel>
        ?? Enumerable.Empty<ImovelViewModel>();
    var ativo = Model.Status == "A";
    var tipo = Model.Tipo == "F" ? "Pessoa física" : "Pessoa jurídica";
}

<div class="titulo-pagina">
    <a class="voltar" asp-action="Index" aria-label="Voltar para a lista de usuários">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
    </a>
    <div>
        <h1>@Model.Nome</h1>
        <p>
            @tipo
            <span class="selo selo--pequeno @(ativo ? "selo--aprovado" : "selo--reprovado")">@(ativo ? "Ativo" : "Bloqueado")</span>
        </p>
    </div>
</div>

@if (Model.FotoPerfil is { Length: > 0 })
{
    <img src="data:image/*;base64,@Convert.ToBase64String(Model.FotoPerfil)"
         alt="Foto de perfil de @Model.Nome"
         class="img-thumbnail mb-3"
         style="max-width: 150px;" />
}

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Email)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>

    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Telefone)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Telefone)</dd>

    @if (Model.Tipo == "F")
    {
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Cpf)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Cpf)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataNascimento)</dt>
        <dd class="col-sm-9">@Model.DataNascimento?.ToString("dd/MM/yyyy")</dd>
    }
    else
    {
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Cnpj)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Cnpj)</dd>
    }
</dl>

<div class="mb-4">
    @if (ativo)
    {
        <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('Deseja realmente bloquear o usuário @Model.Nome?');">
            <input type="hidden" name="ativo" value="false" />
            <button type="submit" class="btn btn-outline-danger">Bloquear</button>
        </form>
    }
    else
    {
        <form asp-action="Activate" asp-route-id="@Model.Id" method="post" class="d-inline">
            <input type="hidden" name="ativo" value="true" />
            <button type="submit" class="btn btn-outline-success">Ativar</button>
        </form>
    }
</div>

<h2>Imóveis anunciados</h2>

@if (!imoveis.Any())
{
    <p class="lista-vazia">Este usuário não possui imóveis anunciados.</p>
}
else
{
    <ul class="lista-anuncios">
        @foreach (var item in imoveis)
        {
            var situacao = item.StatusValidacao switch
            {
                "A" => ("Aprovado", "selo--aprovado"),
                "R" => ("Reprovado", "selo--reprovado"),
                _ => ("Pendente", "selo--pendente")
            };
            var aluguel = item.Finalidade != "V";

            <li>
                <article class="anuncio" aria-labelledby="imovel-@item.Id">
                    <div class="anuncio__dados">
                        <div class="miniatura" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg>
                        </div>
                        <div>
                            <h3 class="anuncio__nome" id="imovel-@item.Id">@item.Nome</h3>
                            <p class="anuncio__local">@item.Bairro, @item.Cidade - @item.Estado</p>
                            <p class="anuncio__valores">
                                <span class="selo selo--pequeno">@(aluguel ? "Aluguel" : "Venda")</span>
                                <span class="preco">@item.Valor.ToString("C0", ptBR)@(aluguel ? "/mês" : "")</span>
                            </p>
                        </div>
                    </div>
                    <p class="anuncio__situacao m-0">
                        <span class="visually-hidden">Validação: </span>
                        <span class="selo @situacao.Item2">@situacao.Item1</span>
                    </p>
                </article>
            </li>
        }
    </ul>
}