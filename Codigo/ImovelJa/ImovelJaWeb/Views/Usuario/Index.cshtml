@model IEnumerable<ImovelJaWeb.Models.PessoaViewModel>

@{
    ViewData["Title"] = "Gerenciar Usuários";
    ViewData["Perfil"] = "Administrador";

    var quantidade = Model.Count();
}

<div class="titulo-pagina">
    <a class="voltar" asp-controller="Home" asp-action="Index" aria-label="Voltar ao início">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
    </a>
    <div>
        <h1>Gerenciar Usuários</h1>
        <p>@(quantidade == 1 ? "1 usuário cadastrado" : $"{quantidade} usuários cadastrados")</p>
    </div>
</div>
@if (TempData["Mensagem"] is string mensagem && !string.IsNullOrWhiteSpace(mensagem))
{
    <div class="alert alert-success" role="status">@mensagem</div>
}

@if (TempData["Erro"] is string erro && !string.IsNullOrWhiteSpace(erro))
{
    <div class="alert alert-danger" role="alert">@erro</div>
}
<div class="mb-4">
    <input type="search" class="form-control rounded-pill"
           style="max-width: 360px;"
           placeholder="Filtrar por nome ou CPF..."
           aria-label="Filtrar por nome ou CPF" />
</div>
@if (quantidade == 0)
{
    <p class="lista-vazia">Nenhum usuário cadastrado no momento.</p>
}
else
{
    var colunas = "display: grid; grid-template-columns: 3fr 1.5fr 1fr auto; align-items: center; column-gap: 1rem;";

    <div class="lista-anuncios__cabecalho" style="@colunas" aria-hidden="true">
        <span>Nome</span>
        <span>CPF</span>
        <span>Status</span>
        <span></span>
    </div>

    <ul class="lista-anuncios">
        @foreach (var item in Model)
        {
            var ativo = item.Status == "A";
            var situacao = ativo
                ? ("Ativo", "selo--aprovado")
                : ("Bloqueado", "selo--reprovado");
            var documento = item.Tipo == "F"
                ? (item.Cpf is { Length: 11 }
                    ? $"{item.Cpf[..3]}.{item.Cpf[3..6]}.{item.Cpf[6..9]}-{item.Cpf[9..]}"
                    : item.Cpf)
                : (item.Cnpj is { Length: 14 }
                    ? $"{item.Cnpj[..2]}.{item.Cnpj[2..5]}.{item.Cnpj[5..8]}/{item.Cnpj[8..12]}-{item.Cnpj[12..]}"
                    : item.Cnpj);
            <li>
                <article class="anuncio" style="@colunas" aria-labelledby="usuario-@item.Id">
                    <div>
                        <h2 class="anuncio__nome" id="usuario-@item.Id">@item.Nome</h2>
                        <p class="anuncio__local m-0">@item.Email</p>
                    </div>

                    <p class="m-0">
                        <span class="visually-hidden">Documento: </span>@documento
                    </p>

                    <p class="m-0">
                        <span class="visually-hidden">Situação: </span>
                        <span class="selo @situacao.Item2">@situacao.Item1</span>
                    </p>

                    <div class="d-flex flex-row flex-nowrap align-items-center justify-content-end gap-2">
                        <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.Id">
                            Detalhes<span class="visually-hidden"> de @item.Nome</span>
                        </a>

                        @if (ativo)
                        {
                            <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline"
                                  data-confirm-nome="@item.Nome">
                                <input type="hidden" name="ativo" value="false" />
                                <button type="submit" class="btn btn-outline-danger">
                                    Bloquear<span class="visually-hidden"> @item.Nome</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                <input type="hidden" name="ativo" value="true" />
                                <button type="submit" class="btn btn-outline-success">
                                    Ativar<span class="visually-hidden"> @item.Nome</span>
                                </button>
                            </form>
                        }
                    </div>
                </article>
            </li>
        }
    </ul>
}