@model ImovelJaWeb.Models.ImovelViewModel

@{
    ViewData["Title"] = "Validar Anúncio";

    var tipo = Model.Tipo switch
    {
        "C" => "Casa",
        "A" => "Apartamento",
        "T" => "Terreno",
        "S" => "Studio",
        "CO" => "Comercial",
        "O" => "Outro",
        _ => Model.Tipo
    };
    var finalidade = Model.Finalidade switch
    {
        "A" => "Aluguel",
        "V" => "Venda",
        _ => Model.Finalidade
    };
    var situacao = Model.StatusValidacao switch
    {
        "P" => "Pendente",
        "A" => "Aprovado",
        "R" => "Reprovado",
        _ => Model.StatusValidacao
    };
}

<h1>Validar Anúncio</h1>

<div>
    <h4>Dados do anúncio</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tipo)
        </dt>
        <dd class = "col-sm-10">
            @tipo
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Finalidade)
        </dt>
        <dd class = "col-sm-10">
            @finalidade
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Valor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Valor)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.QuantidadeQuartos)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.QuantidadeQuartos)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.QuantidadeBanheiros)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.QuantidadeBanheiros)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.QuantidadeVagasGaragem)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.QuantidadeVagasGaragem)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AreaTotal)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AreaTotal)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AreaCozinha)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AreaCozinha)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AreaSala)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AreaSala)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AreaQuintal)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AreaQuintal)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AreaLavanderia)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AreaLavanderia)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Rua)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Rua)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Bairro)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Bairro)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cep)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cep)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cidade)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cidade)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Estado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Estado)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StatusValidacao)
        </dt>
        <dd class = "col-sm-10">
            @situacao
        </dd>
    </dl>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <form asp-action="Approve">
        <input type="hidden" asp-for="Id" />
        <button type="submit" name="aprovado" value="false" class="btn btn-danger">Reprovar</button>
        <button type="submit" name="aprovado" value="true" class="btn btn-success">Aprovar</button> |
        <a asp-action="Pendentes">Voltar para a lista</a>
    </form>
</div>
