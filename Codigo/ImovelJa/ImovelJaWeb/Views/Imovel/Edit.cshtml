@model ImovelJaWeb.Models.ImovelViewModel

@{
    ViewData["Title"] = "Editar imóvel";
    ViewData["Perfil"] = "Usuario";
    ViewData["NomeUsuario"] = "Proprietário";
    ViewData["IdPessoa"] = Model.IdPessoaProprietario;
    ViewData["Acao"] = "Edit";
    ViewData["TituloFormulario"] = "Editar imóvel";
}

<div class="titulo-pagina">
    <a class="voltar" asp-action="Index" asp-route-idPessoa="@Model.IdPessoaProprietario" aria-label="Voltar para a gestão de imóveis">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
    </a>
    <div>
        <h1>Editar imóvel</h1>
        <p>Atualize os dados do anúncio</p>
    </div>
</div>

@if (Model.Id == 0)
{
    <div asp-validation-summary="ModelOnly"></div>
    <p class="lista-vazia">Imóvel não encontrado.</p>
}
else
{
    <partial name="_Formulario" model="Model" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
