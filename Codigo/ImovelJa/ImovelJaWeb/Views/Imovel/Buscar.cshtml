@model IEnumerable<ImovelJaWeb.Models.ImovelViewModel>

@{
    ViewData["Title"] = "Buscar Imóvel";

    var filtro = ViewData["Filtro"] as ImovelFiltroViewModel ?? new ImovelFiltroViewModel();
    var ptBR = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var quantidade = Model.Count();
    var tipos = new Dictionary<string, string>
    {
        ["C"] = "Casa",
        ["A"] = "Apartamento",
        ["T"] = "Terreno",
        ["S"] = "Studio",
        ["CO"] = "Comercial",
        ["O"] = "Outro"
    };
}

<h1>Buscar Imóvel</h1>

<form method="get" asp-action="Buscar" class="mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label for="Termo" class="form-label">Termo de busca</label>
            <input id="Termo" name="Termo" value="@filtro.Termo" class="form-control" maxlength="100" />
        </div>
        <div class="col-12 col-md-6">
            <label for="Localizacao" class="form-label">Localização</label>
            <input id="Localizacao" name="Localizacao" value="@filtro.Localizacao" class="form-control" maxlength="100" />
        </div>
        <div class="col-6 col-md-3">
            <label for="ValorMinimo" class="form-label">Valor mínimo</label>
            <input id="ValorMinimo" name="ValorMinimo" value="@filtro.ValorMinimo" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label for="ValorMaximo" class="form-label">Valor máximo</label>
            <input id="ValorMaximo" name="ValorMaximo" value="@filtro.ValorMaximo" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-6 col-md-2">
            <label for="AreaMinima" class="form-label">Área mínima</label>
            <input id="AreaMinima" name="AreaMinima" value="@filtro.AreaMinima" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-6 col-md-2">
            <label for="AreaMaxima" class="form-label">Área máxima</label>
            <input id="AreaMaxima" name="AreaMaxima" value="@filtro.AreaMaxima" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-12 col-md-2">
            <label for="QuantidadeQuartos" class="form-label">Quartos</label>
            <input id="QuantidadeQuartos" name="QuantidadeQuartos" value="@filtro.QuantidadeQuartos" type="number" min="0" max="100" class="form-control" />
        </div>
        <div class="col-12">
            <span class="form-label d-block">Tipos de imóvel</span>
            @foreach (var tipo in tipos)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="Tipos" id="tipo-@tipo.Key"
                           value="@tipo.Key" checked="@(filtro.Tipos?.Contains(tipo.Key) == true)" />
                    <label class="form-check-label" for="tipo-@tipo.Key">@tipo.Value</label>
                </div>
            }
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filtrar</button>
        <a class="btn btn-outline-secondary" asp-action="Buscar">Limpar filtros</a>
    </div>
</form>

@if (ViewData.ModelState.IsValid && quantidade == 0)
{
    <p>Nenhum imóvel encontrado para os critérios informados</p>
}
else if (quantidade > 0)
{
    <p>@(quantidade == 1 ? "1 imóvel encontrado" : $"{quantidade} imóveis encontrados")</p>

    <table class="table">
        <thead>
            <tr>
                <th>Imóvel</th>
                <th>Local</th>
                <th>Tipo</th>
                <th>Quartos</th>
                <th>Área</th>
                <th>Valor</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var aluguel = item.Finalidade != "V";
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Bairro, @item.Cidade - @item.Estado</td>
                    <td>@(tipos.GetValueOrDefault(item.Tipo, "Outro"))</td>
                    <td>@item.QuantidadeQuartos</td>
                    <td>@(item.AreaTotal.HasValue ? $"{item.AreaTotal.Value.ToString("0.##", ptBR)} m²" : "")</td>
                    <td>@item.Valor.ToString("C0", ptBR)@(aluguel ? "/mês" : "")</td>
                    <td><a asp-action="Detalhes" asp-route-id="@item.Id">Ver detalhes</a></td>
                </tr>
            }
        </tbody>
    </table>
}