@model ImovelJaWeb.Models.ImovelViewModel

@{
    ViewData["Title"] = Model.Id == 0 ? "Anúncio" : Model.Nome;

    var ptBR = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var aluguel = Model.Finalidade == "A";
    var area = Model.AreaTotal.HasValue ? Model.AreaTotal.Value.ToString("0.##", ptBR) + "m²" : "-";
}

@if (Model.Id == 0)
{
    <p class="lista-vazia">Este anúncio não está disponível.</p>
}
else
{
    <div class="detalhe-publico">
        <div class="titulo-pagina">
            <a class="voltar" asp-controller="Home" asp-action="Index" aria-label="Voltar ao início">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
            </a>
        </div>

        <article class="detalhe-anuncio" aria-labelledby="nome-anuncio">
            <div class="detalhe-anuncio__corpo">
                <div class="galeria" aria-hidden="true">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="galeria__item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><circle cx="8.5" cy="10" r="1.5" /><path d="m21 15-5-4-8 8" /></svg>
                        </div>
                    }
                </div>

                <header>
                    <div class="detalhe-anuncio__topo">
                        <h1 id="nome-anuncio">@Model.Nome</h1>
                        <p class="preco m-0">@Model.Valor.ToString("C0", ptBR)@(aluguel ? "/mês" : "")</p>
                    </div>
                    <p class="detalhe-anuncio__local">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                        @Model.Bairro, @Model.Cidade - @Model.Estado
                    </p>
                </header>

                <dl class="faixa-dados">
                    <div>
                        <dd>@(Model.QuantidadeQuartos?.ToString() ?? "-")</dd>
                        <dt>Quartos</dt>
                    </div>
                    <div>
                        <dd>@(Model.QuantidadeBanheiros?.ToString() ?? "-")</dd>
                        <dt>Banheiros</dt>
                    </div>
                    <div>
                        <dd>@(Model.QuantidadeVagasGaragem?.ToString() ?? "-")</dd>
                        <dt>Vagas de Garagem</dt>
                    </div>
                    <div>
                        <dd>@area</dd>
                        <dt>Área</dt>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.Descricao))
                {
                    <h2 class="detalhe-publico__subtitulo">Descrição</h2>
                    <p class="detalhe-anuncio__descricao">@Model.Descricao</p>
                }

                <div class="mapa" aria-hidden="true">
                    <svg class="mapa__icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 6 9 4 15 6 21 4 21 18 15 20 9 18 3 20" /><line x1="9" y1="4" x2="9" y2="18" /><line x1="15" y1="6" x2="15" y2="20" /></svg>
                    <p>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                        @Model.Bairro, @Model.Cidade - @Model.Estado
                    </p>
                </div>

                <partial name="_BotaoContato" />
            </div>
        </article>
    </div>
}
