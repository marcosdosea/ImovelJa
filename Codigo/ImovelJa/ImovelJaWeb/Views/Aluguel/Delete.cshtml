@model ImovelJaWeb.Models.AluguelViewModel

@{
    ViewData["Title"] = "Cancelar Aluguel";
    ViewData["Perfil"] = "Usuario";
    ViewData["NomeUsuario"] = "Proprietário";

    var imovel = Model.Imovel;
    var inquilino = Model.Inquilino;
    var nomeInquilino = inquilino?.Nome ?? "o inquilino";
    var local = imovel == null
        ? string.Empty
        : string.Join(" — ", new[] { imovel.Bairro, imovel.Cidade }.Where(parte => !string.IsNullOrWhiteSpace(parte)));
    var nomeImovel = string.IsNullOrWhiteSpace(imovel?.Nome) ? "Imóvel" : imovel.Nome;
    var idProprietario = imovel?.IdPessoaProprietario ?? 0u;
}

<div class="titulo-pagina">
    <a class="voltar" asp-action="Details" asp-route-id="@Model.Id" asp-route-idPessoa="@idProprietario" aria-label="Voltar para o aluguel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
    </a>
    <div>
        <h1>Ver Aluguel</h1>
        @if (!string.IsNullOrWhiteSpace(local))
        {
            <p>@local</p>
        }
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

@* Modal de confirmação de cancelamento centralizado na tela *@
<div class="cancelamento-overlay" role="dialog" aria-modal="true" aria-labelledby="cancelamento-titulo">
    <div class="cancelamento-modal">
        <div class="cancelamento-modal__icone" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
        </div>

        <h2 id="cancelamento-titulo" class="cancelamento-modal__titulo">Cancelar aluguel?</h2>
        <p class="cancelamento-modal__texto">
            Esta ação irá remover <strong>@nomeInquilino</strong> como inquilino.
            O histórico de pagamentos será mantido dentro dos detalhes do imóvel.
        </p>

        <div class="acoes-formulario">
            <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@Model.Id" asp-route-idPessoa="@idProprietario">Voltar</a>

            <form asp-action="Delete" method="post" data-envio-unico class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Cancelar aluguel</button>
            </form>
        </div>
    </div>
</div>
