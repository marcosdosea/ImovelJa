@model IEnumerable<ImovelJaWeb.Models.AluguelViewModel>

@{
    ViewData["Title"] = "Meus Imóveis";
    ViewData["Perfil"] = "Usuario";

    var ptBR = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    var lista = Model.ToList();
    var quantidade = lista.Count;
    var idPessoa = ViewData["IdPessoa"] is uint informado ? informado : 0u;
    var resumo = quantidade == 1 ? "1 imóvel vinculado" : $"{quantidade} imóveis vinculados";
}

<div class="titulo-pagina">
    <div>
        <h1>Meus Imóveis</h1>
        <p>@resumo</p>
    </div>
</div>

<div asp-validation-summary="ModelOnly"></div>

@if (quantidade == 0)
{
    <p class="lista-vazia">Nenhum imóvel vinculado a este inquilino.</p>
}
else
{
    <div class="busca-campo mb-4" role="search">
        <svg class="busca-campo__icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        <label class="visually-hidden" for="filtro-imoveis">Filtrar imóveis</label>
        <input id="filtro-imoveis" type="search" class="busca-campo__entrada" placeholder="Filtrar imóveis..."
               autocomplete="off" data-filtro-lista="lista-imoveis" />
    </div>

    <ul class="lista-anuncios" id="lista-imoveis">
        @foreach (var item in lista)
        {
            var imovel = item.Imovel;
            var nome = string.IsNullOrWhiteSpace(imovel?.Nome) ? "Imóvel" : imovel.Nome;
            var alugado = item.Status == "A";
            var situacao = alugado ? ("Alugado", "") : ("Cancelado", "selo--reprovado");
            var caracteristicas = new List<string>();
            if (imovel?.QuantidadeQuartos is uint quartos)
            {
                caracteristicas.Add(quartos == 1 ? "1 quarto" : $"{quartos} quartos");
            }
            if (imovel?.AreaTotal is decimal area)
            {
                caracteristicas.Add($"{area.ToString("0.##", ptBR)} m²");
            }
            caracteristicas.Add($"{item.Valor.ToString("C0", ptBR)}/mês");
            var local = imovel == null
                ? string.Empty
                : $"{imovel.Bairro}, {imovel.Cidade} - {imovel.Estado}";

            <li data-filtro-texto="@nome @local">
                <article class="anuncio" aria-labelledby="imovel-@item.Id">
                    <div class="anuncio__dados">
                        <div class="miniatura" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></svg>
                        </div>
                        <div>
                            <h2 class="anuncio__nome" id="imovel-@item.Id">@nome</h2>
                            @if (!string.IsNullOrWhiteSpace(local))
                            {
                                <p class="anuncio__local">@local</p>
                            }
                            <p class="anuncio__valores">@string.Join(" ", caracteristicas)</p>
                        </div>
                    </div>
                    <p class="anuncio__situacao m-0">
                        <span class="visually-hidden">Situação: </span>
                        <span class="selo @situacao.Item2">@situacao.Item1</span>
                    </p>
                    <a class="btn btn-primary anuncio__acao" asp-action="Details" asp-route-id="@item.Id" asp-route-idPessoa="@idPessoa">
                        Ver aluguel<span class="visually-hidden"> de @nome</span>
                    </a>
                </article>
            </li>
        }
    </ul>

    <p class="lista-vazia mt-3" role="status" data-filtro-vazio="lista-imoveis" hidden>
        Nenhum imóvel encontrado para o filtro informado.
    </p>
}
