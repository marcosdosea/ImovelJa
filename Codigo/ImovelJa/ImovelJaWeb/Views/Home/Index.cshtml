@{
    ViewData["Title"] = "Início";
}

<h1>Encontre seu imóvel</h1>

<form method="get" asp-controller="Imovel" asp-action="Buscar" class="d-flex gap-2">
    <input type="search" name="Termo" maxlength="100" class="form-control"
           placeholder="Buscar imóvel" aria-label="Buscar imóvel" />
    <button type="submit" class="btn btn-primary">Buscar</button>
</form>