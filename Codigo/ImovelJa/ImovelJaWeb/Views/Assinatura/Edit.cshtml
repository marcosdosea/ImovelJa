@model ImovelJaWeb.Models.AssinaturaViewModel

@{
    ViewData["Title"] = "Trocar o plano";
    ViewData["Perfil"] = "Usuario";
    ViewData["NomeUsuario"] = "Proprietário";
    ViewData["IdPessoa"] = Model.IdPessoa;
    ViewData["Acao"] = "Edit";
}

@if (Model.Id == 0)
{
    <div class="titulo-pagina">
        <a class="voltar" asp-controller="Home" asp-action="Index" aria-label="Voltar ao início">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12" /><polyline points="12 19 5 12 12 5" /></svg>
        </a>
        <div>
            <h1>Trocar o plano</h1>
        </div>
    </div>

    <p class="lista-vazia">Assinatura não encontrada.</p>
}
else
{
    <partial name="_EscolhaPlano" model="Model" />
}
